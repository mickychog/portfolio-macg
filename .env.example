# Inbox that receives contact-form messages.
CONTACT_TO_EMAIL=your-email@example.com

# Sender address from a domain verified in Resend. Do not use an unverified Gmail address here.
PORTFOLIO_FROM_EMAIL=Portfolio <contact@your-domain.com>

# Server-only secrets. Create them in the Resend and Cloudflare Turnstile dashboards.
RESEND_API_KEY=re_replace_with_your_key
TURNSTILE_SECRET_KEY=replace_with_your_secret_key

# Public Turnstile site key; this value is intentionally exposed to the browser.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace_with_your_site_key
